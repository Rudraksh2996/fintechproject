# LOCAL DEVELOPMENT ONLY: replace these demo credentials before deployment.
# Copy to .env; never commit .env. In containers, hostnames are overridden by Compose.
DEMO_MODE=true
SEED=42
SEC_USER_AGENT="YourOrg you@example.com"
SEC_MAX_RPS=8
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech
POSTGRES_USER=fintech_admin
POSTGRES_PASSWORD=local_demo_admin_change_me
POSTGRES_APP_USER=fintech_app
POSTGRES_APP_PASSWORD=local_demo_app_change_me
WORKBENCH_RO_PASSWORD=local_demo_readonly_change_me
NEO4J_AUTH=neo4j/local_demo_graph_change_me
NEO4J_URI=bolt://localhost:7687
MULE_SCALE=demo
GNN_ARCH=graphsage
RISK_ALERT_THRESHOLD=0.8
REPORTING_THRESHOLD=10000
REPLAY_SPEED=1
LOG_LEVEL=INFO
ORIGIN=http://localhost:8080
DATABASE_TIMEOUT_SECONDS=10
